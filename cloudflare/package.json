{
  "name": "opensnap-cloudflare-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:ui": "npm --prefix ../frontend run build",
    "deploy": "npm run build:ui && wrangler deploy",
    "dry-run": "npm run build:ui && wrangler deploy --dry-run",
    "dev": "npm run build:ui && wrangler dev",
    "types": "wrangler types"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "wrangler": "^4.45.0"
  }
}
