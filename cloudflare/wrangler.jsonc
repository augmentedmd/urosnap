{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Keep in sync with the dashboard Worker / root wrangler.jsonc name.
  "name": "urosnap",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-12",
  "upload_source_maps": true,
  "preview_urls": true,
  "previews": {},
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    // Built by: cd ../frontend && npm run build
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Intercept clinical-looking paths so Cloudflare never pretends to be the API.
    "run_worker_first": ["/api/*", "/ws/*", "/docs", "/docs/*", "/openapi.json", "/redoc", "/opensnap.json"]
  }
}
